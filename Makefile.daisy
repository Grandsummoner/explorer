# Electrosmith Daisy Seed Hardware Makefile for Hermetic Modular "Explorer"
# Project Name
TARGET = Explorer

# Sources
CPP_SOURCES = src/main_daisy.cpp src/stereo_eq.cpp src/cloud_delay.cpp

# Library Locations (expects libDaisy and DaisySP cloned or vendored)
LIBDAISY_DIR ?= ../../libDaisy
DAISYSP_DIR ?= ../../DaisySP

# Core location, and generic Makefile.
SYSTEM_FILES_DIR = $(LIBDAISY_DIR)/core
include $(SYSTEM_FILES_DIR)/Makefile
